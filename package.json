  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "lint": "biome lint agent app components evals hooks lib scripts *.ts *.mjs",
    "format": "biome format --write agent app components evals hooks lib scripts *.ts *.mjs",
    "check": "biome check --write agent app components evals hooks lib scripts *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "bunx knip@5 --include exports",
