# =====================================================================
# MiniScira — environment configuration
# =====================================================================
#
#   cp .env.example .env
#
# This file is the single source of truth for deployment configuration.
# REQUIRED variables are validated at application startup (lib/env-check.ts):
# the app fails fast with a clear error when one is missing. Everything else
# is optional — off or defaulted unless set. (A couple of variables are
# documented here as "reserved" for an upcoming phase: they are not yet read
# by the code, so setting them currently has no effect.)
#
# When deploying with the repo's docker-compose.yml the database hostname in
# DATABASE_URL is `db` (the compose service name) and POSTGRES_PASSWORD must
# match the password embedded in DATABASE_URL.

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# ---- Database (any PostgreSQL-compatible server with pgvector) ----
# Plain Postgres connection string. The database MUST have the pgvector
# extension — the repo compose ships pgvector/pgvector:pg16, which includes
# it. Managed Postgres that supports pgvector: Neon, Supabase, RDS, etc.
# First-time setup on a fresh database: `bun run db:setup` (creates the
# vector extension), then apply the schema (db:push / RUN_DB_PUSH / the
# compose migrate step).
#   postgresql://miniscira:CHANGE_ME@db:5432/miniscira   (repo compose)
DATABASE_URL=

# ---- AI gateway (any OpenAI-compatible endpoint) ----
# Every model call — chat, image generation, the researcher subagent, the
# model catalog — goes through this ONE endpoint. There is NO fallback and no
# Vercel dependency. Point it at your own gateway/proxy, e.g.
#   http://gateway:8000/v1                    (same Docker network)
#   http://host.docker.internal:8317/v1       (gateway on the Docker host)
#   https://api.example.com/v1                (remote OpenAI-compatible)
AI_GATEWAY_BASE_URL=

# ---- better-auth ----
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (browser-facing). Behind a reverse proxy use the
# external URL.
#   http://umbrel.local:8325                  (LAN)
#   https://miniscira.example.com             (public)
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# OPTIONAL — everything below is off or defaulted unless set
# ---------------------------------------------------------------------

# ---- Migrations & startup (Phase 2) ----
# TRANSITIONAL schema gate, default OFF: "true" makes the container entrypoint
# run `drizzle-kit push` (under a Postgres advisory lock — only one instance
# wins, others skip) BEFORE starting the app. Exists for stacks adopted from
# the pre-migration era (stack-30 continuity). The committed-migration path is
# the target: `docker compose --profile migrate run --rm migrate` applies
# lib/db/migrations/*.sql once, and normal startup NEVER mutates the schema.
RUN_DB_PUSH=false
# How long the entrypoint waits for the database before failing (ms).
# DB_WAIT_TIMEOUT_MS=90000
# How long the RUN_DB_PUSH gate waits for the advisory lock (ms).
# RUN_DB_PUSH_LOCK_TIMEOUT_MS=60000

# ---- Auth / access ----
# Gateway key for the shared-key path and the model catalog. Users may instead
# save their own key in Settings (sealed at rest, lib/secret-box.ts); when
# ALLOW_SHARED_GATEWAY_KEY=true and a user has no saved key, turns run on this
# shared key. Optional: a deployment whose users all BYOK needs no shared key.
AI_GATEWAY_API_KEY=
# "true" lets users who have NOT saved their own gateway key in Settings fall
# back to the shared AI_GATEWAY_API_KEY. Self-hosted deployments (single
# household / LAN) should set this to "true": everyone shares the deployment's
# gateway key.
ALLOW_SHARED_GATEWAY_KEY=
# Public origin used for absolute links; defaults to BETTER_AUTH_URL (see
# lib/base-url.ts for precedence).
APP_URL=
# Extra origins better-auth accepts callbacks from, comma-separated — e.g. a
# LAN IP alongside the hostname in BETTER_AUTH_URL:
#   BETTER_AUTH_TRUSTED_ORIGINS=http://10.0.0.5:8325
BETTER_AUTH_TRUSTED_ORIGINS=

# ---- Model selection (optional overrides) ----
# Default chat model used when the user has not picked one (composer default,
# turn fallback, researcher subagent). When unset, the built-in default
# (gpt-5.6-sol) applies. The model id must be served by AI_GATEWAY_BASE_URL —
# the live gateway catalog is authoritative, and a default it does not serve
# logs a startup warning. Server-side defaults (agent, router, fallback) read
# this variable at RUNTIME; the client picker's initial selection is baked at
# image build time via the DEFAULT_CHAT_MODEL build arg (NEXT_PUBLIC_*), so
# changing this after build updates the server default without a rebuild.
DEFAULT_CHAT_MODEL=
# Optional METADATA-ONLY override for the model picker: a JSON object keyed by
# model id. It does NOT change which models are available — the gateway's
# /v1/models catalog remains the authoritative availability list, and
# AI_MODELS_JSON can neither add nor force models. Schema-validated at boot.
# Supported per-model keys:
#   name          display name in the picker/chat header (overrides gateway)
#   hint          one-line picker hint, e.g. "Fast & cheap"
#   hidden        true hides the model from the picker (availability intact)
#   order         explicit picker position (lower first; unset = default sort)
#   capabilities  { vision?: bool, fileInput?: bool } display hints
# Example:
#   AI_MODELS_JSON={"gpt-5.6-sol":{"name":"Sol (MoA)","order":1,"hint":"Flagship"}}
AI_MODELS_JSON=
# Image model served by the AI gateway for the generate_image tool. Whether
# the gateway supports an images endpoint depends on its backend; the tool
# reports a failure gracefully when it does not.
IMAGE_MODEL=gpt-image-2

# ---- File uploads (local storage replaces Vercel Blob) ----
# Files land in LOCAL_STORAGE_DIR and are served by the app at /api/files/*.
# The directory is created on demand; mount a volume there for durability
# (the repo compose does).
LOCAL_STORAGE_DIR=/data/uploads
# Legacy env kept for compatibility; unused by local storage.
BLOB_READ_WRITE_TOKEN=

# ---- Sandbox (eve run_code / bash tools) ----
# The sandbox backend is CURRENTLY HARDCODED to eve's just-bash backend
# (agent/sandbox.ts): run_code and the bash tool execute as plain bash
# subprocesses inside the app container — NO Docker-level isolation, and the
# container needs no docker socket and no docker CLI (the image bakes in the
# analysis stack: python3 + pandas/numpy/matplotlib). A configurable docker
# backend is future work; until then there is nothing to configure here.
# Vercel-only vars below are unused in self-hosted deployments.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ---- Search providers (the agent's only web access) ----
# eve's built-in web_search/web_fetch are switched off in agent/tools/, so
# with none of these set the agent cannot reach the web at all.
# Exa neural search — https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Firecrawl search + scrape — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Self-hosted Firecrawl base URL (defaults to the Firecrawl cloud API).
#   FIRECRAWL_API_URL=http://host.docker.internal:3002  (self-hosted firecrawl)
FIRECRAWL_API_URL=
# xAI key for X (Twitter) search via x_search — https://console.x.ai
XAI_API_KEY=
# You.com key for Reddit search via reddit_search — https://api.you.com
YOU_COM_API_KEY=

# ---- Lookouts (scheduled research) ----
# Due runs are leased in-database by the `lookouts` eve schedule — no external
# queue. Secret for the internal headless-run auth path (server-to-server).
# Generate: openssl rand -hex 32
LOOKOUT_RUN_SECRET=
# Used only when BOTH APP_URL and BETTER_AUTH_URL are unset — lib/base-url.ts
# has the precedence.
VERCEL_PROJECT_PRODUCTION_URL=
# Resend for lookout result emails — https://resend.com/api-keys (verify a
# domain for LOOKOUT_EMAIL_FROM)
RESEND_API_KEY=
LOOKOUT_EMAIL_FROM="MiniScira Lookout <onboarding@resend.dev>"

# ---- Demo mode (optional; off unless set) ----
# "true" serves a landing page at / and folds every other app route back to
# it. For a public showcase deployment that is not meant to be used as a
# product. Leave unset when self-hosting — that is what gives you the actual
# chat. /docs and /sign-in keep working either way.
DEMO_MODE=

# ---- Rate limiting (optional; off unless set) ----
# Per-user requests per minute on /api/*. In-memory, so the ceiling is per
# process — a brake on one runaway client, not a quota. Does NOT cap model
# spend: agent turns go over /eve/v1/* and bypass the route handlers. Those
# are bounded by maxOutputTokensPerSession / maxInputTokensPerSession in
# agent/agent.ts.
RATE_LIMIT_PER_MINUTE=

# ---- Social providers (optional; email+password works without these) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in (optional) — create an OAuth App and set the callback to
# <origin>/api/auth/callback/github (see lib/auth.ts).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Sign in with Vercel (optional; identity only) ----
# Create a Vercel App (dashboard -> Account Settings -> Apps) and set the
# redirect to <origin>/api/auth/callback/vercel. Enable openid/email/profile
# and offline_access. Identity ONLY: users supply their own gateway key in
# Settings; sign-in does not pay for anything. Email/password login works
# without any of this — leave these blank unless you want the Vercel button.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# ---- Compose / build (used by docker-compose.yml only) ----
# Host port the app is published on (compose: ${APP_PORT:-3000}:3000).
APP_PORT=3000
# Docker build target platform (see Dockerfile; arm64 native is blocked by
# @firecrawl/pdf-inspector, which ships no linux-arm64 NAPI binding).
IMAGE_PLATFORM=linux/amd64
# App image name/tag when building via compose.
MINISCIRA_IMAGE=miniscira:local
# Postgres credentials for the compose db service. NOTE: compose reads
# POSTGRES_PASSWORD from ITS interpolation environment (the root .env,
# shell variables, or --env-file) — not from the app's env_file — and it
# must match the password embedded in DATABASE_URL.
POSTGRES_USER=miniscira
POSTGRES_PASSWORD=
POSTGRES_DB=miniscira
# TRANSITIONAL: set "true" to run `bun run db:push` at container start.
# Default off — normal startup never mutates the schema (see the plan's
# Phase 2 migration notes).
RUN_DB_PUSH=
