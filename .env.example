# ---- Sign in with Vercel (the default login; identity only) ----
# Create a Vercel App (dashboard → Account Settings → Apps) and set the redirect
# to <origin>/api/auth/callback/vercel. Enable openid/email/profile and
# offline_access ON THE APP — scopes come from the App's own configuration, and
# the code deliberately sends no scope parameter (requesting one the App lacks
# fails the authorize call with `invalid_scope`).
#
# This is IDENTITY ONLY. Measured: the token it returns 401s at the AI Gateway,
# 403s on /v2/teams and 401s on /v1/api-keys — it reaches
# /login/oauth/userinfo and nothing else. Users supply their own gateway key in
# Settings; sign-in does not pay for anything.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Set to "true" to let users who have NOT saved their own gateway key in
# Settings fall back to the deployment's AI_GATEWAY_API_KEY below. Handy
# locally; leave unset in production or you are paying for everyone's research.
ALLOW_SHARED_GATEWAY_KEY=

# ---- Model (Vercel AI Gateway) ----
# Chat turns run on the gateway key the SIGNED-IN USER saved in Settings, sealed
# at rest (lib/secret-box.ts) — not on this key. This one covers the reranker,
# cohere/rerank-v4-fast, which runs with no user attached, and stands in for
# users who have not saved a key when ALLOW_SHARED_GATEWAY_KEY is set.
# Get a key from https://vercel.com/ai-gateway (or run `vercel link` to use OIDC).
AI_GATEWAY_API_KEY=

# ---- Sandbox (Vercel Sandbox — powers the bash/file tools) ----
# On Vercel this works automatically. For local dev, either run `vercel link`
# (provides VERCEL_OIDC_TOKEN), or set a token + team + project:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ---- Database (Neon Postgres) ----
# Neon connection string, e.g. postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Document search needs the pgvector extension: run `bun run db:setup` once, then `bun run db:push`.
DATABASE_URL=

# ---- File uploads (Vercel Blob — stores uploaded documents) ----
# Create a Blob store in the Vercel dashboard, or run `vercel link`. Token from the store's settings.
BLOB_READ_WRITE_TOKEN=

# ---- better-auth ----
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- Search providers (the agent's only web access) ----
# eve's built-in web_search/web_fetch are switched off in agent/tools/, so with
# none of these set the agent cannot reach the web at all.
# Exa neural search — https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Firecrawl search + scrape — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# xAI key for X (Twitter) search via x_search — https://console.x.ai
XAI_API_KEY=
# You.com key for Reddit search via reddit_search — https://api.you.com
YOU_COM_API_KEY=

# ---- Lookouts (scheduled research) ----
# Due runs are leased in-database by the `lookouts` eve schedule — no external queue.
# Secret for the internal headless-run auth path (server-to-server). Generate: openssl rand -hex 32
LOOKOUT_RUN_SECRET=
# Public origin for absolute links in lookout emails (see lib/base-url.ts).
APP_URL=http://localhost:3000
# Set automatically on Vercel. Used only when BOTH APP_URL and BETTER_AUTH_URL
# are unset — lib/base-url.ts has the precedence.
VERCEL_PROJECT_PRODUCTION_URL=
# Resend for lookout result emails — https://resend.com/api-keys (verify a domain for LOOKOUT_EMAIL_FROM)
RESEND_API_KEY=
LOOKOUT_EMAIL_FROM="MiniScira Lookout <onboarding@resend.dev>"

# ---- Demo mode (optional; off unless set) ----
# "true" serves a landing page at / and folds every other app route back to it.
# For a public showcase deployment that is not meant to be used as a product.
# Leave unset when self-hosting — that is what gives you the actual chat.
# /docs and /sign-in keep working either way.
DEMO_MODE=

# ---- Rate limiting (optional; off unless set) ----
# Per-user requests per minute on /api/*. In-memory, so the ceiling is per
# process — a brake on one runaway client, not a quota. Does NOT cap model
# spend: agent turns go over /eve/v1/* and bypass the route handlers. Those are
# bounded by maxOutputTokensPerSession / maxInputTokensPerSession in agent/agent.ts.
RATE_LIMIT_PER_MINUTE=

# ---- Social providers (optional; email+password works without these) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
