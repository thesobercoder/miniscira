# ---- Sign in with Vercel (optional; identity only) ----
# Create a Vercel App (dashboard -> Account Settings -> Apps) and set the redirect
# to <origin>/api/auth/callback/vercel. Enable openid/email/profile and
# offline_access. Scopes come from the App's own configuration; the code sends
# no scope parameter. Identity ONLY: users supply their own gateway key in
# Settings; sign-in does not pay for anything.
# Email/password login works without any of this — leave these blank unless you
# want the Vercel button.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Set to "true" to let users who have NOT saved their own gateway key in
# Settings fall back to the deployment's AI_GATEWAY_API_KEY below. Self-hosted
# deployments (single household / LAN) should set this to "true": everyone
# shares the deployment's gateway key.
ALLOW_SHARED_GATEWAY_KEY=

# ---- Model (AI Gateway) ----
# Chat turns run on the gateway key the SIGNED-IN USER saved in Settings, sealed
# at rest (lib/secret-box.ts) — or, with ALLOW_SHARED_GATEWAY_KEY=true, on this
# shared key. Everything is served by the deployment's own OpenAI-compatible
# gateway (CLIProxyAPI by default) — see AI_GATEWAY_BASE_URL below. No Vercel
# account needed.
AI_GATEWAY_API_KEY=
# Base URL of the OpenAI-compatible gateway, e.g. http://host.docker.internal:8317/v1
# (default when unset, which suits a same-host Docker deployment).
AI_GATEWAY_BASE_URL=

# ---- Sandbox (runs the bash/file tools) ----
# Self-hosted: eve's docker backend spawns sandbox containers on the host
# daemon. The app container must mount /var/run/docker.sock and have the docker
# CLI (the image installs it). The sandbox image is python:3.12-slim unless you
# change agent/sandbox.ts. Vercel-only vars below are unused here.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ---- Database (self-hosted Postgres with pgvector) ----
# Plain Postgres connection string, e.g. postgresql://miniscira:password@db:5432/miniscira
# The database must have the pgvector extension: run `bun run db:setup` once,
# then `bun run db:push`.
DATABASE_URL=

# ---- File uploads (local storage replaces Vercel Blob) ----
# Files land in LOCAL_STORAGE_DIR and are served by the app at /api/files/*.
# Directory is created on demand; mount a volume there for durability.
LOCAL_STORAGE_DIR=/data/uploads
# Legacy env kept for compatibility; unused by local storage.
BLOB_READ_WRITE_TOKEN=

# ---- better-auth ----
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public origin (browser-facing) used for absolute links; see lib/base-url.ts
# for precedence. Defaults to BETTER_AUTH_URL.
APP_URL=

# ---- Search providers (the agent's only web access) ----
# eve's built-in web_search/web_fetch are switched off in agent/tools/, so with
# none of these set the agent cannot reach the web at all. Self-hosted
# deployments should point Firecrawl at their own instance:
# FIRECRAWL_API_URL=http://host.docker.internal:3002  (self-hosted firecrawl)
# Exa neural search — https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Firecrawl search + scrape — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Self-hosted Firecrawl base URL (defaults to the Firecrawl cloud API).
FIRECRAWL_API_URL=
# xAI key for X (Twitter) search via x_search — https://console.x.ai
XAI_API_KEY=
# You.com key for Reddit search via reddit_search — https://api.you.com
YOU_COM_API_KEY=

# ---- Image generation (optional tool) ----
# Image model served by the AI gateway for the generate_image tool. Whether the
# gateway supports an images endpoint depends on its backend; the tool reports
# a failure gracefully when it does not.
IMAGE_MODEL=gpt-image-2

# ---- Lookouts (scheduled research) ----
# Due runs are leased in-database by the `lookouts` eve schedule — no external queue.
# Secret for the internal headless-run auth path (server-to-server). Generate: openssl rand -hex 32
LOOKOUT_RUN_SECRET=
# Public origin for absolute links in lookout emails (see lib/base-url.ts).
# Used only when BOTH APP_URL and BETTER_AUTH_URL are unset — lib/base-url.ts has the precedence.
VERCEL_PROJECT_PRODUCTION_URL=
# Resend for lookout result emails — https://resend.com/api-keys (verify a domain for LOOKOUT_EMAIL_FROM)
RESEND_API_KEY=
LOOKOUT_EMAIL_FROM="MiniScira Lookout <onboarding@resend.dev>"

# ---- Demo mode (optional; off unless set) ----
# "true" serves a landing page at / and folds every other app route back to it.
# For a public showcase deployment that is not meant to be used as a product.
# Leave unset when self-hosting — that is what gives you the actual chat.
# /docs and /sign-in keep working either way.
DEMO_MODE=

# ---- Rate limiting (optional; off unless set) ----
# Per-user requests per minute on /api/*. In-memory, so the ceiling is per
# process — a brake on one runaway client, not a quota. Does NOT cap model
# spend: agent turns go over /eve/v1/* and bypass the route handlers. Those are
# bounded by maxOutputTokensPerSession / maxInputTokensPerSession in agent/agent.ts.
RATE_LIMIT_PER_MINUTE=

# ---- Social providers (optional; email+password works without these) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
