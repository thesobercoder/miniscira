# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# eve
# .eve/ is dev cache and traces; .output/ is the agent's built Nitro bundle
# (~12MB) that `eve build` regenerates. Neither belongs in the repo.
/.eve/
/.output/

# fumadocs (generated from source.config.ts + content/docs)
/.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent and editor state, not part of the project
# (.eve/ and .output/ are covered by the eve section above)
.workflow-data/
.agents/
.claude/
.vercel